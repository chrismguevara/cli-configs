#!/usr/bin/env bash
# Create the fixture repository and five Git worktrees with per-worktree
# .workspace.env files. Idempotent: existing repo/worktrees/branches are kept.
#
#   ~/src/fixture-monorepo      main checkout (branch main)
#   ~/worktrees/1 .. 5          worktrees on branches ws/1 .. ws/5
#
# Ports per workspace (FRONTEND/API/KEYCLOAK/POSTGRES):
#   1: 5173 8081 8181 5433   2: 5174 8082 8182 5434   3: 5175 8083 8183 5435
#   4: 5176 8084 8184 5436   5: 5177 8085 8185 5437
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
FIXTURE_SRC="${REPO_ROOT}/test/fixture-monorepo"
SRC_DIR="${FIXTURE_DIR:-$HOME/src/fixture-monorepo}"
WT_ROOT="${WORKTREES_DIR:-$HOME/worktrees}"
COUNT=5

log() { printf '\033[1;34m==> %s\033[0m\n' "$*"; }
ok()  { printf '\033[1;32m    ok: %s\033[0m\n' "$*"; }

# 1. fixture repository ------------------------------------------------------
if [[ ! -d "${SRC_DIR}/.git" ]]; then
  log "creating fixture repository at ${SRC_DIR}"
  mkdir -p "$(dirname "${SRC_DIR}")"
  cp -r "${FIXTURE_SRC}" "${SRC_DIR}"
  git -C "${SRC_DIR}" init -q -b main
  git -C "${SRC_DIR}" -c user.name=fixture -c user.email=fixture@example.invalid add -A
  git -C "${SRC_DIR}" -c user.name=fixture -c user.email=fixture@example.invalid commit -q -m "fixture monorepo"
  ok "initialised ${SRC_DIR} (branch main)"
else
  ok "fixture repository exists: ${SRC_DIR}"
fi

# 2. worktrees + env files -----------------------------------------------------
mkdir -p "${WT_ROOT}"
for n in $(seq 1 "${COUNT}"); do
  dir="${WT_ROOT}/${n}"
  branch="ws/${n}"
  if git -C "${SRC_DIR}" worktree list --porcelain | grep -qx "worktree ${dir}"; then
    ok "worktree ${n} exists: ${dir}"
  else
    log "creating worktree ${n} -> ${dir} (${branch})"
    if git -C "${SRC_DIR}" show-ref --verify --quiet "refs/heads/${branch}"; then
      git -C "${SRC_DIR}" worktree add -q "${dir}" "${branch}"
    else
      git -C "${SRC_DIR}" worktree add -q -b "${branch}" "${dir}" main
    fi
  fi

  env_file="${dir}/.workspace.env"
  cat > "${env_file}.tmp" <<ENV
# Generated by bin/setup-worktrees for worktree ${n}. Ports only; no secrets.
# Loaded by bin/ws-run and by dotfiles/bashrc when a shell starts in this directory.
WORKSPACE_NUMBER=${n}
WORKSPACE_NAME=ws${n}
WORKTREE_DIR=${dir}
FRONTEND_PORT=$((5172 + n))
API_PORT=$((8080 + n))
KEYCLOAK_PORT=$((8180 + n))
POSTGRES_PORT=$((5432 + n))
# Convenience for the services: bind to localhost only.
BIND_HOST=127.0.0.1
ENV
  if [[ -f "${env_file}" ]] && cmp -s "${env_file}" "${env_file}.tmp"; then
    rm -f "${env_file}.tmp"
  else
    mv "${env_file}.tmp" "${env_file}"
    ok "wrote ${env_file}"
  fi
done

# 3. frontend dependencies (project-local oxfmt/typescript/eslint per worktree) --
if command -v pnpm >/dev/null; then
  for n in $(seq 1 "${COUNT}"); do
    fe="${WT_ROOT}/${n}/frontend"
    if [[ ! -x "${fe}/node_modules/.bin/oxfmt" ]]; then
      log "pnpm install in ${fe}"
      (cd "${fe}" && pnpm install --frozen-lockfile --silent)
    fi
  done
  ok "frontend node_modules present in worktrees 1-${COUNT}"
else
  echo "    note: pnpm not on PATH; run 'pnpm install' in each worktree's frontend/ later" >&2
fi

git -C "${SRC_DIR}" worktree list
