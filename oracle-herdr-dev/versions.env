# Versions actually tested by this repository (see docs/installation.md).
# Change a value deliberately, then re-run the matching install script.
# Nothing here is "latest on login": upgrades are explicit.

# install/neovim.sh   -- https://github.com/neovim/neovim/releases
NEOVIM_VERSION=v0.12.5
# Neovim publishes no checksum file, so the tarball SHA-256s are pinned here
# (recompute with `curl -fsSL <asset-url> | sha256sum` when bumping).
NEOVIM_SHA256_x86_64=bce0f56eda1f1b1db6eee8f4133d7a38813ea07933837dd1777411ca384c6875
NEOVIM_SHA256_aarch64=1aa5ca085249580ae0f91eb14f27ec0919773ff2d99a163d03f3d6c21ac29725
# install/tree-sitter.sh -- https://github.com/tree-sitter/tree-sitter/releases
TREE_SITTER_VERSION=v0.27.0
TREE_SITTER_SHA256_x86_64=20a1f39ec1c45f2211492dcb8881c802b643b554bb196869a29ac3778277fa77
TREE_SITTER_SHA256_aarch64=3a35a2dd961ad842384e982c75daf792c01d1a67e442fc3914d4de37bd8a59cb
# The prebuilt tree-sitter CLI (>= 0.26) needs glibc 2.39; Oracle Linux 9 has
# 2.34, so install/tree-sitter.sh builds the same version from the official
# crates.io source with a pinned Rust toolchain (rustup, minimal profile).
RUST_TOOLCHAIN=1.98.1
# install/herdr.sh    -- https://github.com/herdrdev/herdr/releases (static musl binaries)
# SHA-256 values come from Herdr's signed manifest (https://herdr.dev/latest.json,
# mirrored at distribution/latest.json in the repo) for this exact version.
HERDR_VERSION=v0.9.1
HERDR_SHA256_x86_64=2a02fed16beb651ef006e1d43f048f652ca4dc58ad053cd2d44450563d5c54b7
HERDR_SHA256_aarch64=f4ccf4de745f2cb9a39a983e9ba3703dad50ec2a58dea83026ceab721bbd8d9e
# install/opencode.sh -- https://github.com/anomalyco/opencode/releases
# OpenCode publishes no checksum file; SHA-256s of the release tarballs are pinned here.
OPENCODE_VERSION=v1.18.32
OPENCODE_SHA256_x64=3046e0404fdc60fb80307e7a47824ba07477364178a4d09baa8548496dd6d43b
OPENCODE_SHA256_x64_baseline=763af386ef88a8cab18df00fcf055690e5a55e31a7088beabe02307142a6adce
OPENCODE_SHA256_arm64=568461b7d4d8c19865c97e9a1102e613049c6039d01fe772154de873c1865840
# install/golang.sh   -- https://go.dev/dl/
GO_VERSION=1.27.1
# install/node.sh     -- nvm tag, Node LTS, pnpm (Corepack)
NVM_VERSION=v0.40.8
NODE_VERSION=24.21.0
PNPM_VERSION=12.6.0
# global npm language servers (install/node.sh). TypeScript stays on 6.x:
# TypeScript 7 (native port) no longer ships tsserver, which vtsls needs.
TYPESCRIPT_VERSION=6.0.3
VTSLS_VERSION=0.3.0
VSCODE_LANGSERVERS_VERSION=4.10.0
# install/lazygit.sh  -- DNF/COPR is preferred; this pin is the GitHub-release fallback
LAZYGIT_VERSION=v0.65.1
