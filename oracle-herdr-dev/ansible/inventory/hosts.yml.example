# Copy to inventory/hosts.yml (git-ignored) and set the VM's public IP
# (`terraform output public_ip`). Nothing secret belongs here: the private key
# stays in ~/.ssh and is referenced by path.
all:
  children:
    dev:
      hosts:
        ol9-herdr-dev:
          ansible_host: 203.0.113.10
          ansible_user: opc
          ansible_ssh_private_key_file: ~/.ssh/id_ed25519
